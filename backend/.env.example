# Server Configuration
PORT=3001

# Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Or:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Environment variables directly
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_firebase_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com

# Optional Web SDK fallback
# ENABLE_WEB_FIRESTORE=false
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

# Auth hardening
# Local development WITHOUT a Firebase service account only. Never enable in production.
ALLOW_INSECURE_DEV_AUTH=false
# Lets new accounts register as doctor (demo). Set to false in production and promote doctors manually.
ALLOW_DOCTOR_SELF_SIGNUP=true
# Comma-separated allowed browser origins, e.g. http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Set to 1 when running behind a reverse proxy / load balancer (so rate limits use the real client IP)
# TRUST_PROXY=1
