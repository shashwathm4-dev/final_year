rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }

    // Users: profile is created by the backend only. Owner may edit display name only.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid || resource.data.doctorId == request.auth.uid
      );
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'updatedAt']);
      allow delete: if false;
    }

    // Sessions and reps: read by the patient or their linked doctor. Writes only via backend.
    match /sessions/{sessionId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.patientId
        || userDoc(resource.data.patientId).doctorId == request.auth.uid
      );
      allow write: if false;

      match /reps/{repId} {
        allow read: if signedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.patientId
          || userDoc(get(/databases/$(database)/documents/sessions/$(sessionId)).data.patientId).doctorId == request.auth.uid
        );
        allow write: if false;
      }
    }

    // Exercises: built-ins readable by all signed-in users, custom ones by their creator.
    match /exercises/{exerciseId} {
      allow read: if signedIn() && (
        resource.data.isCustom == false || resource.data.createdBy == request.auth.uid
      );
      allow write: if false;
    }

    // Assignments: readable by the two parties, written by backend only.
    match /assignedExercises/{docId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId
      );
      allow write: if false;
    }

    // Session comments (Item 24): readable by session owner or assigned doctor. Writes via backend.
    match /sessionComments/{commentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Playback data (Item 23): same access as the parent session. Writes via backend.
    match /playback/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
